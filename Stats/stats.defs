!include "..\..\..\..\Build\make.defs"

EXIE = $(BUILD_ROOT)\Release\Product\Exie
EXIEINC = $(EXIE)\Runtime\Include
EXIEBIN = $(EXIE)\Runtime\Binaries\$(PLATFORM)\$(CONFIGURATION)
LIBCOMMON = $(EXIE)\LibCommon

DEFINES = $(DEFINES) /DOLYMPCORE_EXPORTS

INCLUDES =  \
  $(INCLUDES) \
  /I..\ \
  /I..\dist \
  /I..\..\Math\ReductionsScans \
  /I..\DataProcessing \
  /I..\Regression \
  /I$(EXIEINC) \
  /I$(LIBCOMMON) \
  /I$(INTEL_IPP_INCLUDES) \
  /I$(INTEL_MKL_INCLUDES) \

LIBS = $(TARGET_DIR)\TCMath.lib \
    $(TARGET_DIR_COMMON)\TCCommon.lib \
    $(EXIEBIN)\ExieRuntime.lib \
    $(TARGET_DIR_COMMON)\LibCommon.lib \
    $(INTEL_IPP_LIBS_L) \
    $(LIBS) \

SYSTEM_LIBS = \
    user32.lib \

# note: since TCMath.h may be rebuilt whenever Math is rebuilt,
# all objects in this directory may be rebuilt whenever Math is rebuilt

DEPS = \
  ..\stdafx.h \
  ..\targetver.h \
  ..\OlympCoreUtils.h \
  $(TCINCLUDE)\OlympCore.h \
  $(TCINCLUDE)\TCMath.h \
  $(TCINCLUDE)\TCCommon.h \
  $(TCINCLUDE)\TCComplex.h \
  $(TCINCLUDE)\TCError.h \
  $(TCINCLUDE)\TCInternal.h \
  $(TCINCLUDE)\TCTypes.h \
  $(TCINCLUDE)\TCArray.h \
  $(TCINCLUDE)\TCReduce.h \
  $(TCINCLUDE)\TCFuncWrapper.h \
  $(LIBCOMMON)\LibCommon.h \

