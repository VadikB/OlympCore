<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">

  <Import Project="$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), build.root))\Build\Common.Build.settings" />

  <PropertyGroup>
    <Root>$([MSBuild]::GetDirectoryNameOfFileAbove($(MSBuildThisFileDirectory), build.root))</Root>
    <TasksPath>$(Root)\Build\</TasksPath>
    <DevGroup></DevGroup>
  </PropertyGroup>

  <ItemGroup>
    <ProjectFile Include="Client\OlympCore.vcxproj"/>
    <ProjectFile Include="Server\OlympCoreDist.vcxproj" Condition="'$(Platform)' != 'Win32'"/>
  </ItemGroup>

  <Import Project="$(TargetsPath)\Common.Build.Traversal.targets" />

</Project>
